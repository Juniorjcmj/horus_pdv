<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApiOutput>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../NETCORE/bin/$(Configuration)/net8.0'))</ApiOutput>
    <GatewayOutput>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../GATEWAY/src/HorusGateway/bin/$(Configuration)/net8.0'))</GatewayOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HORUSPDV-API"><HintPath>$(ApiOutput)/HORUSPDV-API.dll</HintPath></Reference>
    <Reference Include="HorusGateway"><HintPath>$(GatewayOutput)/HorusGateway.dll</HintPath></Reference>
    <Reference Include="NFe.Classes"><HintPath>$(ApiOutput)/NFe.Classes.dll</HintPath></Reference>
    <Reference Include="NFe.Utils"><HintPath>$(ApiOutput)/NFe.Utils.dll</HintPath></Reference>
    <Reference Include="DFe.Classes"><HintPath>$(ApiOutput)/DFe.Classes.dll</HintPath></Reference>
    <Reference Include="System.Security.Cryptography.Xml"><HintPath>$(ApiOutput)/System.Security.Cryptography.Xml.dll</HintPath></Reference>
    <Content Include="$(GatewayOutput)/DataBase/Schemas/*.xsd" Link="DataBase/Schemas/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(GatewayOutput)/DataBase/FiscalTables/*.json" Link="DataBase/FiscalTables/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
