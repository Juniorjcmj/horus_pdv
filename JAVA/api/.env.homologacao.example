# Copie para .env.homologacao e preencha. Nunca versione o arquivo preenchido.
MSSQL_SA_PASSWORD=TroqueEstaSenhaForte#2026
DB_NAME=HorusPdv

# 32+ caracteres. Num banco restaurado da producao, use os MESMOS valores da API .NET
# (Auth__JwtSecret e Security__EncryptionKey), senao senhas SMTP cifradas e tokens antigos deixam de valer.
QUACK_AUTH_JWT_SECRET=troque-por-um-segredo-jwt-com-pelo-menos-32-caracteres
QUACK_SECURITY_ENCRYPTION_KEY=troque-por-uma-chave-de-cifra-com-pelo-menos-32-caracteres

# Imagem publicada pela CI (branch spring-api)
QUACK_API_IMAGE=ghcr.io/SEU_USUARIO/quack-pdv-api-java:spring-api
API_PORT=8080
SQL_PORT=14333
# Vazio = producao. 'dev' so para teste (Swagger + usuario de demonstracao flavio@hpdv.com.br / Senha#Quack2026)
SPRING_PROFILES_ACTIVE=

# Opcionais
QUACK_SECURITY_CORS_ORIGINS=
QUACK_SECURITY_TRUST_FORWARDED_HEADERS=false
QUACK_RECAPTCHA_ENABLED=false
QUACK_RECAPTCHA_SECRET_KEY=
QUACK_EMAIL_ENABLED=false
QUACK_EMAIL_HOST=smtp-mail.outlook.com
QUACK_EMAIL_PORT=587
QUACK_EMAIL_USER=
QUACK_EMAIL_PASSWORD=
QUACK_EMAIL_FROM_EMAIL=
QUACK_EMAIL_FRONTEND_BASE_URL=
