<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HorusGateway</RootNamespace>
    <AssemblyName>HorusGateway</AssemblyName>
    <UserSecretsId>horus-gateway-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same official fiscal package ships with API and LAN Gateway, including self-contained publishes. -->
    <Content Include="../../../API/NETCORE/DataBase/Schemas/nfe_v4.00.xsd;../../../API/NETCORE/DataBase/Schemas/leiauteNFe_v4.00.xsd;../../../API/NETCORE/DataBase/Schemas/tiposBasico_v4.00.xsd;../../../API/NETCORE/DataBase/Schemas/DFeTiposBasicos_v1.00.xsd;../../../API/NETCORE/DataBase/Schemas/xmldsig-core-schema_v1.01.xsd"
             Link="DataBase/Schemas/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../API/NETCORE/DataBase/FiscalTables/cclass.json"
             Link="DataBase/FiscalTables/cclass.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../../../API/NETCORE/Services/Fiscal/FiscalReferenceTables.cs" Link="Services/FiscalReferenceTables.cs" />
  </ItemGroup>

</Project>
