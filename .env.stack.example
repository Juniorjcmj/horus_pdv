# Arquivo: .env.stack.example
# Objetivo: documenta as variáveis que o docker-compose.yml espera ao rodar como stack no
#           Portainer. Copie os valores necessários para Portainer > Stacks > <stack> >
#           Environment variables (não precisa subir um .env de verdade a lugar nenhum) —
#           ou, se preferir, salve como ".env" ao lado do docker-compose.yml no host.
#
# NUNCA versione um arquivo ".env" real (com senhas de verdade) neste repositório.

# --- Registro de imagens (ghcr.io) ---
# Dono das imagens no GitHub Container Registry — normalmente seu usuário/organização do
# GitHub em minúsculas (ghcr.io é case-sensitive e exige minúsculo). As imagens são
# publicadas pelo workflow como ghcr.io/<GHCR_NAMESPACE>/horus-pdv-api e
# .../horus-pdv-frontend.
GHCR_NAMESPACE=seu-usuario-do-github
IMAGE_TAG=latest

# --- SQL Server ---
# Requisito de complexidade do SQL Server: 8+ caracteres, com maiúscula, minúscula, número
# e símbolo. Gere com: openssl rand -base64 24
MSSQL_SA_PASSWORD=

# --- Segredos da API ---
# Ambos: strings aleatórias longas. Gere com: openssl rand -base64 48
# ENCRYPTION_KEY cifra CSC, senha do certificado digital e senha de SMTP salvos no banco —
# se você trocar esse valor depois de configurado, tudo isso vira ilegível e precisa ser
# recadastrado. Gere uma vez, guarde num cofre de senhas, nunca regenere sem necessidade.
JWT_SECRET=
ENCRYPTION_KEY=

# --- E-mail (opcional — deixe em branco/false se não for usar recuperação de senha por e-mail agora) ---
EMAIL_ENABLED=false
EMAIL_HOST=smtp-mail.outlook.com
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- reCAPTCHA v3 (opcional) ---
# O site key (público) fica no build do frontend — ver o build-arg VITE_RECAPTCHA_SITE_KEY
# no workflow do GitHub Actions, não aqui. Aqui só a secret key (privada) do backend.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
